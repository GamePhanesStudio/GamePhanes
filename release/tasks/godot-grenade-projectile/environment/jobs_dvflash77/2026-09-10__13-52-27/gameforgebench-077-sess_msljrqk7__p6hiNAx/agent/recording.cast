[20.674862, "o", "[application]\r\nconfig/name=\"Godot Grenade Throw and Smoke Lifecycle\"\r\nrun/main_scene=\"res://Main.tscn\"\r\n\r\n[display]\r\nwindow/size/viewport_width=640\r\nwindow/size/viewport_height=360\r\nwindow/size/window_width_override=640\r\nwindow/size/window_height_override=360\r\n\r\n[rendering]\r\nrenderer/rendering_method=\"gl_compatibility\"\r\nrenderer/rendering_method.mobile=\"gl_compatibility\"\r\n\u001b[?2004hroot@e7274b02129c:/app# "]
[57.133175, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('scripts/grenade_physics.gd')\ns = p.read_text()\ns = s.replace('''func throw_velocity(speed: float, angle_rad: float) -> Vector2:\\n    return Vector2.ZERO''', '''func throw_velocity(speed: float, angle_rad: float) -> Vector2:\\n    if speed <= 0.0:\\n        return Vector2.ZERO\\n    return Vector2(speed * cos(angle_rad), speed * sin(angle_rad))''')\ns = s.replace('''func throw_grenade(speed: float, angle_rad: float) -> Dictionary:\\n    return {}''', '''func throw_grenade(speed: float, angle_rad: float) -> Dictionary:\\n    if speed <= 0.0:\\n        return {}\\n    var projectile := {\\n        \"position\": Vector2.ZERO,\\n        \"velocity\": throw_velocity(speed, angle_rad),\\n        \"active\": true\\n    }\\n    projectiles.append(projectile)\\n    return projectile''')\ns = s.replace('''func advance_projectile(projectile: Dictionary, delta: float) -> bool:\\n    return false''', '''func advance_projectile(projectile: Dictionary, delta: float) -> bool:\\n    if delta <= 0.0 or projectile.is_empty():\\n        return false\\n    projectile[\"position\"] = projectile[\"position\"] + projectile[\"velocity\"] * delta\\n    return true''')\ns = s.replace('''func spawn_burn_pool(position: Vector2, radius: float, duration: float) -> Dictionary:\\n    return {}''', '''func spawn_burn_pool(position: Vector2, radius: float, duration: float) -> Dictionary:\\n    if radius <= 0.0 or duration <= 0.0:\\n        return {}\\n    var pool := {\\n        \"position\": position,\\n        \"radius\": radius,\\n        \"remaining\": duration,\\n        \"active\": true\\n    }\\n    burn_pools.append(pool)\\n    return pool''')\ns = s.replace('''func advance_burn_pool(pool: Dictionary, delta: float) -> bool:\\n    return false''', '''func advance_burn_pool(pool: Dictionary, delta: float) -> bool:\\n    if delta <= 0.0 or pool.is_empty():\\n        return false\\n    pool[\"remaining\"] = pool[\"remaining\"] - delta\\n    if pool[\"remaining\"] <= 0.0:\\n        pool[\"active\"] = false\\n    return true''')\ns = s.replace('''func smoke_state(elapsed: float, lifetime: float) -> String:\\n    return \"extinguished\"''', '''func smoke_state(elapsed: float, lifetime: float) -> String:\\n    if elapsed < lifetime:\\n        return \"active\"\\n    return \"extinguished\"''')\np.write_text(s)\nPY\nsed -n '1,240p' scripts/grenade_physics.gd\n"]

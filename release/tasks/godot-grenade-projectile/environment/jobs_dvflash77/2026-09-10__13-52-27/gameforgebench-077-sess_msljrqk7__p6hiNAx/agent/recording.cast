[184.434338, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('scripts/grenade_physics.gd')\ns = p.read_text()\ns = s.replace('''func advance_burn_pool(pool: Dictionary, delta: float) -> bool:\\n    if delta <= 0.0 or pool.is_empty():\\n        return false\\n    pool[\"remaining\"] = pool[\"remaining\"] - delta\\n    if pool[\"remaining\"] <= 0.0:\\n        pool[\"active\"] = false\\n    return true''', '''func advance_burn_pool(pool: Dictionary, delta: float) -> bool:\\n    if delta <= 0.0 or pool.is_empty() or not pool.get(\"active\", false):\\n        return false\\n    pool[\"remaining\"] = pool[\"remaining\"] - delta\\n    if pool[\"remaining\"] <= 0.0:\\n        pool[\"active\"] = false\\n    return true''')\np.write_text(s)\nPY\nsed -n '55,90p' scripts/grenade_physics.gd\n"]
[184.438345, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('scripts/grenade_physics.gd')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text()\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('''func advance_burn_pool(pool: Dictionary, delta: float) -> bool:\\n    if delta <= 0.0 or pool.is_empty():\\n        return false\\n    pool[\"remaining\"] = pool[\"remaining\"] - delta\\n    if pool[\"remaining\"] <= 0.0:\\n        pool[\"active\"] = false\\n    return true''', '''func advance_burn_pool(pool: Dictionary, delta: float) -> bool:\\n    if delta <= 0.0 or pool.is_empty() or not pool.get(\"active\", false):\\n        return false\\n    pool[\"remaining\"] = pool[\"remaining\"] - delta\\n    if pool[\"remaining\"] <= 0.0:\\n        pool[\"active\"] = false\\n    return true''')\r\n\u001b[?2004l\r"]
[184.438439, "o", "\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]

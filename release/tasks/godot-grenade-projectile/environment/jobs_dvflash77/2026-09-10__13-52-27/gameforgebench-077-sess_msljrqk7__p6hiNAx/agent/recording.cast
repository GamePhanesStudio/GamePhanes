e_state(1.0, 1.0) != \"extinguished\": quit(1); return\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"GRENADE_SCENE_PROBE_OK\")\r\n\u001b[?2004l\r\u001b[?2004h>     quit(0)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]

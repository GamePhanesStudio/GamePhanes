[57.14068, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text()\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('''func throw_velocity(speed: float, angle_rad: float) -> Vector2:\\n    return Vector2.ZERO''', '''func throw_velocity(speed: float, angle_rad: float) -> Vector2:\\n    if speed <= 0.0:\\n        return Vector2.ZERO\\n    return Vector2(speed * cos(angle_rad), speed * sin(angle_rad))''')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('''func throw_grenade(speed: float, angle_rad: float) -> Dictionary:\\n    return {}''', '''func throw_grenade(speed: float, angle_rad: float) -> Dictionary:\\n    if speed <= 0.0:\\n        return {}\\n    var projectile := {\\n        \"position\": Vector2.ZERO,\\n        \"velocity\": throw_velocity(speed, angle_rad),\\n        \"active\": true\\n    }\\n    projectiles.append(projectile)\\n    return projectile''')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('''func advance_projectile(projectile: Dictionary, delta: float) -> bool:\\n    return false''', '''func advance_projectile(projectile: Dictionary, delta: float) -> bool:\\n    if delta <= 0.0 or projectile.is_empty():\\n        return false\\n    projectile[\"position\"] = projectile[\"position\"] + projectile[\"velocity\"] * delta\\n    return true''')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.142701, "o", "s = s.replace('''func spawn_burn_pool(position: Vector2, radius: float, duration: float) -> Dictionary:\\n    return {}''', '''func spawn_burn_pool(position: Vector2, radius: float, duration: float) -> Dictionary:\\n    if radius <= 0.0 or duration <= 0.0:\\n        return {}\\n    var pool := {\\n        \"position\": position,\\n        \"radius\": radius,\\n        \"remaining\": duration,\\n        \"active\": true\\n    }\\n    burn_pools.append(pool)\\n    return pool''')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('''func advance_burn_pool(pool: Dictionary, delta: float) -> bool:\\n    return false''', '''func advance_burn_pool(pool: Dictionary, delta: float) -> bool:\\n    if delta <= 0.0 or pool.is_empty():\\n        return false\\n    pool[\"remaining\"] = pool[\"remaining\"] - delta\\n    if pool[\"remaining\"] <= 0.0:\\n        pool[\"active\"] = false\\n    return true''')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('''func smoke_state(elapsed: float, lifetime: float) -> String:\\n    return \"extinguished\"''', '''func smoke_state(elapsed: float, lifetime: float) -> String:\\n    if elapsed < lifetime:\\n        return \"active\"\\n    return \"extinguished\"''')\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[57.183709, "o", "\u001b[?2004hroot@e7274b02129c:/app# sed -n '1,240p' scripts/grenade_physics.gd\r\n\u001b[?2004l\r"]
[57.18581, "o", "extends Node\r\nclass_name GrenadePhysics\r\n\r\nvar projectiles: Array[Dictionary] = []\r\nvar burn_pools: Array[Dictionary] = []\r\n\r\nfunc reset_for_reload() -> void:\r\n    projectiles.clear()\r\n    burn_pools.clear()\r\n\r\nfunc throw_velocity(speed: float, angle_rad: float) -> Vector2:\r\n    if speed <= 0.0:\r\n        return Vector2.ZERO\r\n    return Vector2(speed * cos(angle_rad), speed * sin(angle_rad))\r\n\r\nfunc throw_grenade(speed: float, angle_rad: float) -> Dictionary:\r\n    if speed <= 0.0:\r\n        return {}\r\n    var projectile := {\r\n        \"position\": Vector2.ZERO,\r\n        \"velocity\": throw_velocity(speed, angle_rad),\r\n        \"active\": true\r\n    }\r\n    projectiles.append(projectile)\r\n    return projectile\r\n\r\nfunc advance_projectile(projectile: Dictionary, delta: float) -> bool:\r\n    if delta <= 0.0 or projectile.is_empty():\r\n        return false\r\n    projectile[\"position\"] = projectile[\"position\"] + projectile[\"velocity\"] * delta\r\n    return true\r\n\r\nfunc spawn_burn_pool(position: Vector2, radius: float, duration: float) -> Dictionary:\r\n    if radius <= 0.0 or duration <= 0.0:\r\n        return {}\r\n    var pool := {\r\n        \"position\": position,\r\n        \"radius\": radius,\r\n        \"remaining\": duration,\r\n        \"active\": true\r\n    }\r\n    burn_pools.append(pool)\r\n    return pool\r\n\r\nfunc advance_burn_pool(pool: Dictionary, delta: float) -> bool:\r\n    if delta <= 0.0 or pool.is_empty():\r\n        return false\r\n    pool[\"remaining\"] = pool[\"remaining\"] - delta\r\n    if pool[\"remaining\"] <= 0.0:\r\n        pool[\"active\"] = false\r\n    return true\r\n\r\nfunc smoke_state(elapsed: float, lifetime: float) -> String:\r\n    if elapsed < lifetime:\r\n        return \"active\"\r\n    return \"extinguished\"\r\n"]

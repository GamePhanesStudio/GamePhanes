[137.420764, "o", ">     if grenade.advance_burn_pool(pool, 0.1): quit(1); return\r\n\u001b[?2004l\r\u001b[?2004h>     if not grenade.throw_grenade(0.0, 0.0).is_empty(): quit(1); return\r\n\u001b[?2004l\r\u001b[?2004h>     if not grenade.spawn_burn_pool(Vector2.ZERO, 0.0, 2.0).is_empty(): quit(1); return\r\n\u001b[?2004l\r\u001b[?2004h>     if not grenade.spawn_burn_pool(Vector2.ZERO, 2.0, 0.0).is_empty(): quit(1); return\r\n\u001b[?2004l\r\u001b[?2004h>     var stable: Dictionary = grenade.spawn_burn_pool(Vector2.ZERO, 2.0, 1.0)\r\n\u001b[?2004l\r\u001b[?2004h>     if grenade.advance_burn_pool(stable, 0.0): quit(1); return\r\n\u001b[?2004l\r\u001b[?2004h>     if not stable.get(\"active\", false): quit(1); return\r\n\u001b[?2004l\r\u001b[?2004h"]

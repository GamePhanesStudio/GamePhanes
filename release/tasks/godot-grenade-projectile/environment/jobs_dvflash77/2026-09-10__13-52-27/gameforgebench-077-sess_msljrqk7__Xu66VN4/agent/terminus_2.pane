real_behavior_contract:
  starter_object: Main.tscn Godot scene with a GrenadePhysics Node child that owns
    projectile, burn-pool, and smoke lifecycle state
  multi_step_events:
  - load Main.tscn and obtain the GrenadePhysics child node
  - create a grenade -> advance it by a fixed delta -> observe its moved position
  - create a valid burn pool -> advance before and at its duration -> observe active
    then inactive
  - try non-positive speed, radius, duration, and delta -> verify no invalid state
    is created or advanced
  state_transition: a projectile moves from origin and a burn pool changes active
    to inactive exactly at its duration; smoke changes active to extinguished at its
    lifetime
  boundary_behavior: non-positive speed/radius/duration are rejected and non-positive
    delta does not advance state
  observation: Godot headless loads Main.tscn, drives the native GrenadePhysics scene
    node through ordered calls, and observes its runtime dictionaries
  runtime_adapter: godot
behavior_scoring:
  schema_version: gameforgebench.rubric-behavior.v1
  task_specificity: unique_runtime_contract
  task_contract:

table: Dictionary = grenade.spawn_burn_pool(Vector2.ZERO, 2.0, 1.0)\r\n\u001b[?2004l\r\u001b[?2004h>     if grenade.advance_burn_pool(stable, 0.0): quit(1); return\r\n\u001b[?2004l\r\u001b[?2004h>     if not stable.get(\"active\", false): quit(1); return\r\n\u001b[?2004l\r\u001b[?2004h>     if grenade.smoke_state(0.5, 1.0) != \"active\" or grenade.smoke_state(1.0, 1.0) != \"extinguished\": quit(1); return\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"GRENADE_SCENE_PROBE_OK\")\r\n\u001b[?2004l\r\u001b[?2004h>     quit(0)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
